{
  "name": "dofus-optimizer",
  "version": "0.11.2",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "check": "node --check js/*.js && node --check scripts/*.mjs",
    "sync:data": "node scripts/sync-dofusdude.mjs",
    "sync:spells": "node scripts/sync-spells.mjs",
    "normalize:data": "node scripts/normalize-dofusdude.mjs",
    "normalize:spells": "node scripts/normalize-spells.mjs",
    "sync:normalize": "npm run sync:data && npm run sync:spells && npm run normalize:data && npm run normalize:spells"
  }
}
